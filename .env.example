# Sentimental Logic — Umgebungsvariablen
# Kopiere diese Datei zu .env.local und fülle alle Werte aus
# NIEMALS .env.local in Git committen

# ── SUPABASE ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── TESTDATEN IN DER LIVE-UMGEBUNG ────────────────────────────
# Die Bereinigung löscht ausschließlich technisch markierte Testdatensätze.
TEST_DATA_CLEANUP_ENABLED=false
TEST_SUPABASE_PROJECT_REF=
TEST_DATA_GUARD_ID=
# Mindestens 32 zufällige Zeichen; ausschließlich als Server-/CI-Secret speichern.
# Wird zusätzlich als bewusst eingegebenes Steuerungs-Token im Testdashboard verwendet.
TEST_DATA_CLEANUP_TOKEN=

# ── CRON (externer Scheduler für Auto-Sync) ───────────────────
# Schützt /api/cron/* -- wird von GitHub Actions (.github/workflows/
# facebook-sync-cron.yml) als Bearer-Token mitgeschickt. Mindestens
# 32 zufällige Zeichen; identischer Wert muss auch als GitHub-Repo-Secret
# "CRON_SECRET" hinterlegt werden.
CRON_SECRET=

# ── PLAYWRIGHT ────────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=https://sentinellogic.vercel.app
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=

# ── CLAUDE API ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── KLICKTIPP ─────────────────────────────────────────────────
KLICKTIPP_API_URL=https://api.klicktipp.com
# Bevorzugt: dedizierter Unteraccount mit Rolle "API User".
KLICKTIPP_API_USERNAME=bosydadaq-api2
KLICKTIPP_API_PASSWORD=
# Optional: API-Feldschlüssel eines KlickTipp-Datenfelds "Geschlecht".
# Ohne Wert versucht der Client das Feld über /field.json automatisch zu finden.
KLICKTIPP_GENDER_FIELD_KEY=
# Optionaler Fallback für Partner-Authentifizierung.
KLICKTIPP_PARTNER_USERNAME=bosydadaq-api2
KLICKTIPP_DEVELOPER_KEY=
KLICKTIPP_CUSTOMER_KEY=

# ── DIALFIRE ──────────────────────────────────────────────────
DIALFIRE_API_KEY=
DIALFIRE_API_URL=https://api.dialfire.com
# Kampagnenspezifische Keys werden von der Supabase Edge Function
# send-to-dialfire genutzt -- NICHT hier/in Vercel setzen, sondern per
# `supabase secrets set NAME=wert` bzw. Supabase Dashboard -> Project
# Settings -> Edge Functions -> Secrets:
#   DIALFIRE_API_KEY_FACEBOOK                  (Kampagne SFU6DSEG4RU2Z6HX)
#   DIALFIRE_API_KEY_PKV                        (Kampagne 6X42NJWGH4YA6HC7)
#   DIALFIRE_API_KEY_AUSLANDSKRANKENVERSICHERUNG (Kampagne 7ZXEC6Z53YHPL2GR)

# ── SUPERCHAT ─────────────────────────────────────────────────
SUPERCHAT_API_KEY=
# Optional; Standard ist die offizielle v1.0-API. Nur api.superchat.com ist zulässig.
SUPERCHAT_API_URL=https://api.superchat.com/v1.0

# ── AMISNOW ───────────────────────────────────────────────────
AMISNOW_API_KEY=
AMISNOW_API_URL=

# ── HIDRIVE ───────────────────────────────────────────────────
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
HIDRIVE_ACCESS_TOKEN=

# ── FACEBOOK / TIKTOK ─────────────────────────────────────────
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Formular-IDs für den manuellen/geplanten Pull-Sync (komma-separiert).
# Der Echtzeit-Webhook braucht dies NICHT — er verarbeitet jede eingehende
# Formular-ID automatisch, sofern die Sparte unten bekannt ist.
# Bekannte Formulare -> Sparte (siehe mapFacebookFieldsToContact()):
#   1251160670355401 -> PKV
#   1488535808896676 -> Unternehmerschutz
#   3169048349946307 -> Auslandsreiseversicherung (KinderProfis)
FACEBOOK_FORM_IDS=
TIKTOK_WEBHOOK_SECRET=

# ── CALENDLY ──────────────────────────────────────────────────
CALENDLY_API_KEY=

# ── PLACETEL TELEFONIE ────────────────────────────────────────
# Ausschließlich serverseitig verwenden; niemals mit NEXT_PUBLIC_ prefixen.
PLACETEL_API_BASE_URL=https://api.placetel.de/v2
PLACETEL_API_TOKEN=
PLACETEL_DEFAULT_SIPUID=
# HMAC-Secret aus Placetel: Einstellungen -> Externe APIs; nicht den API-Token wiederverwenden.
PLACETEL_WEBHOOK_TOKEN=
PLACETEL_ALLOWED_COUNTRY_CODES=+49
# Separates Secret für den geplanten internen CDR-Abgleich.
PLACETEL_RECONCILIATION_TOKEN=

# ── GOOGLE DRIVE (Pipeline) ───────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=1YyN0eZTLmvtfYx0doIYIYTss-ciT1bfu
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── CLICKUP (Pipeline) ────────────────────────────────────────
CLICKUP_API_KEY=
CLICKUP_LIST_ID_PHASE1=901523558048
CLICKUP_LIST_ID_PHASE2=901523558052
CLICKUP_LIST_ID_PHASE3=901523558053
CLICKUP_LIST_ID_PHASE4=901523558054

# ── BENACHRICHTIGUNGEN ────────────────────────────────────────
# WhatsApp via CallMeBot (kostenlos)
CALLMEBOT_PHONE=+49...
CALLMEBOT_API_KEY=

# ── STRATO CALDAV (Kalender-Synchronisation) ──────────────────
# Ausschließlich serverseitig verwenden; niemals mit NEXT_PUBLIC_ prefixen.
# URL aus STRATO Webmail -> Kalender-Einstellungen -> Freigabe/Synchronisation.
# USER ist i.d.R. die volle STRATO-E-Mail-Adresse, PASSWORD das reguläre
# Passwort oder ein App-spezifisches Passwort, falls STRATO das anbietet.
STRATO_CALDAV_URL=https://dav.webmail.strato.de/caldav/Y2FsOi8vMC8zMQ
STRATO_CALDAV_USER=
STRATO_CALDAV_PASSWORD=

# ── STRATO E-MAIL-POSTFACH ───────────────────────────────────
# Ausschließlich serverseitig verwenden; niemals mit NEXT_PUBLIC_ prefixen.
# Anmeldung jeweils mit der vollständigen E-Mail-Adresse und dem Postfach-Passwort.
# Offizielle STRATO-Standardwerte: IMAP 993 SSL/TLS, SMTP 465 SSL/TLS.
STRATO_MAIL_USER=
STRATO_MAIL_PASSWORD=
STRATO_MAIL_SENDER_NAME=Allianz Generalvertretung Gün
STRATO_IMAP_HOST=imap.strato.de
STRATO_IMAP_PORT=993
STRATO_SMTP_HOST=smtp.strato.de
STRATO_SMTP_PORT=465
